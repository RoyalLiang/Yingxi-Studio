# Only portable project material is eligible for version control.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/version.json
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/core/
!/scripts/
!/assets/
!/third_party/
!/.github/
!/docs/
/docs/*
!/docs/releasing.md
!/docs/file-navigation.md
!/releases/

# Local build output, fixtures, environment, runtime notes and signing material.
**/build/
**/.gradle/
**/.kotlin/
**/__pycache__/
*.pyc
local.properties
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env
.env.*
**/fixtures-local*
**/test-results/
**/screenshots/
**/*.log
**/*.mp4
**/*.mkv
**/*.srt
**/*.vtt

# mac metadata is also rejected by repository_guard.py, not just ignored.
.DS_Store
._*
__MACOSX/
.AppleDouble/
