# Only portable project material is eligible for version control.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/version.json
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/core/
!/scripts/
!/assets/
!/website/
/website/*
!/website/public/
!/website/tools/
!/website/package.json
!/website/package-lock.json
!/website/wrangler.jsonc
!/website/README.md
!/website/DESIGN.md
!/third_party/
!/.github/
!/docs/
/docs/*
!/docs/releasing.md
!/docs/file-navigation.md
!/docs/explore-play-proposal.md
!/docs/player-controls.md
!/docs/network-settings.md
!/docs/apple-platform-plan.md
!/docs/cloud-integrations.md
!/docs/media-enrichment.md
!/docs/playback-format-support.md
!/docs/worldbook.md
!/docs/world-glossary.md
!/docs/world-integration.md
!/docs/world-statistics.md
!/docs/world-statistics.json
!/docs/wasteland-copy-audit-2026-10-22.md
!/docs/project-metrics.json
!/docs/ios-alpha.md
!/releases/

# Local build output, fixtures, environment, runtime notes and signing material.
**/build/
**/.gradle/
**/.kotlin/
**/__pycache__/
*.pyc
local.properties
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env
.env.*
**/fixtures-local*
**/test-results/
**/screenshots/
**/*.log
**/*.mp4
**/*.mkv
**/*.srt
**/*.vtt

# mac metadata is also rejected by repository_guard.py, not just ignored.
.DS_Store
._*
__MACOSX/
.AppleDouble/

!/ios/
!/deploy/
/deploy/*
!/deploy/cloud-integrations.example.json
**/DerivedData/
**/xcuserdata/
*.xcuserstate

**/.build/
._*
